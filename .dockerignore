# El pipeline deja node_modules en la raíz tras `npm ci` y lo copiamos
# al contenedor. Workspaces anidados sí se ignoran (npm los vincula en la raíz).
backend/node_modules
frontend/node_modules

**/.git
**/.gitignore
**/.env
**/.env.*
!**/.env.example

# Fuente TS del backend (compilada por el CI; el Dockerfile solo copia dist)
backend/src
backend/tsconfig.json
# OJO: las fuentes del frontend SÍ deben llegar al contexto porque el Dockerfile
# las compila en la stage `frontend-builder` (el CI no compila el frontend).

# Build / coverage / logs
**/coverage
**/dist/**/*.map
**/*.log
logs

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docs y herramientas que no van al runtime
README*.md
CLAUDE.md
*.pen
biome.json
scripts
test
.claude

# Docker / CI propios
Dockerfile
.dockerignore
azure-pipelines*.yml
