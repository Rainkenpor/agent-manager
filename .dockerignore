# Las dos stages del Dockerfile ejecutan su propio `npm ci`; no necesitamos
# arrastrar node_modules del host al contexto (ahorra GBs y evita conflictos
# de plataforma host/imagen).
node_modules
backend/node_modules
frontend/node_modules

**/.git
**/.gitignore
**/.env
**/.env.*
!**/.env.example

# OJO: backend/src y frontend/src SÍ deben llegar al contexto porque el
# Dockerfile compila ambos workspaces en la stage `builder` (no dependemos
# de artefactos generados por el CI).

# Build / coverage / logs
**/coverage
**/dist/**/*.map
**/*.log
logs

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docs y herramientas que no van al runtime
README*.md
CLAUDE.md
*.pen
biome.json
scripts
test
.claude

# Docker / CI propios
Dockerfile
.dockerignore
azure-pipelines*.yml
